// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique @db.VarChar(40)
  email     String   @unique
  password  String
  avatarUrl String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  comments Comment[]

  @@map("users")
}

// ─── F1 DOMAIN ───────────────────────────────────────────────────────────────

model Circuit {
  id          String  @id @default(cuid())
  name        String
  country     String
  city        String
  laps        Int
  lengthKm    Float
  lapRecordMs Int?
  lapRecordBy String?
  mapImageUrl String?
  layoutUrl   String?

  race Race?

  @@map("circuits")
}

model Race {
  id        String   @id @default(cuid())
  season    Int
  round     Int
  name      String
  slug      String   @unique
  country   String
  flagUrl   String?
  circuitId String   @unique
  circuit   Circuit  @relation(fields: [circuitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions RaceSession[]
  posts    Post[]

  @@unique([season, round])
  @@map("races")
}

enum SessionType {
  PRACTICE_1
  PRACTICE_2
  PRACTICE_3
  QUALIFYING
  SPRINT_QUALIFYING
  SPRINT
  RACE
}

model RaceSession {
  id       String      @id @default(cuid())
  raceId   String
  race     Race        @relation(fields: [raceId], references: [id], onDelete: Cascade)
  type     SessionType
  startsAt DateTime
  endsAt   DateTime?

  @@unique([raceId, type])
  @@map("race_sessions")
}

// ─── FORUM ───────────────────────────────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(120)
  body      String   @db.Text
  raceId    String
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  body      String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}
